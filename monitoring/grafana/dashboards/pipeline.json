      "type": "stat",
      "title": "Redis",
      "description": "Redis responds to the exporter connection check. DOWN means Redis cannot be reached. UNKNOWN means monitoring cannot determine Redis availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
