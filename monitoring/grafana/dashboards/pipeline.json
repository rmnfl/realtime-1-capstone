    {
      "id": 14,
      "type": "timeseries",
      "title": "Connector and task status",
      "description": "Each series represents one state: 1 means the connector or task is in that state, 0 means it is not. RUNNING alone does not confirm delivery progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_connect_connector_status",
          "legendFormat": "Connector {{connector}} · {{status}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "kafka_connect_task_status",
          "legendFormat": "Task {{connector}}/{{task}} · {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CDC events and Kafka writes / sec",
      "description": "Debezium events observed in streaming mode and source records written by Connect to Kafka. These measure different stages; counters reset on restart and rate() accounts for resets.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(debezium_postgres_totalnumberofeventsseen_total{context=\"streaming\"}[1m])",
          "legendFormat": "Debezium events",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(kafka_connect_source_record_write_total[1m])",
          "legendFormat": "Connect writes to Kafka",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Debezium queued events",
      "description": "Number of events occupying the connector queue: total capacity minus remaining capacity. This is an event count, not a percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "debezium_postgres_queuetotalcapacity{context=\"streaming\"} - debezium_postgres_queueremainingcapacity{context=\"streaming\"}",
          "legendFormat": "Queued events · {{server}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "Events"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Debezium delay · last processed event",
      "description": "Source-to-processing delay reported by Debezium for its last processed event. -1 means no measurement and is excluded. The value can stay unchanged while delivery is stalled; it is not the age of the latest data or end-to-end API freshness.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(debezium_postgres_millisecondsbehindsource{context=\"streaming\"} >= 0) / 1000",
          "legendFormat": "Last event delay · {{server}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Connect and Debezium errors / sec",
      "description": "Rates of record-processing errors and failures. These are new errors per second, not accumulated totals.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
