{
  "uid": "capstone-pipeline",
  "title": "Pipeline",
  "tags": [
    "capstone",
    "pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 12,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service availability",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "description": "Availability of the six application services. UP: the service check succeeds. DOWN: the check fails. UNKNOWN: monitoring cannot determine service state. Availability does not confirm data freshness or end-to-end delivery."
    },
    {
      "id": 36,
      "type": "stat",
      "title": "API",
      "description": "The API process responds to HTTP requests on its built-in /metrics endpoint. UP does not guarantee that business requests or CDC delivery succeed.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"api\"}) or vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "UNKNOWN",
                  "color": "orange"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 32,
          "titleSize": 14
        },
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL",
      "description": "PostgreSQL accepts a connection from the monitoring role. DOWN means the database connection failed. UNKNOWN means monitoring cannot determine database availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(pg_up{job=\"postgres\"} and on(job, instance) (up{job=\"postgres\"} == 1)) or vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "UNKNOWN",
                  "color": "orange"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 32,
          "titleSize": 14
        },
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kafka Connect",
      "description": "The Connect process responds and exposes connector state from the worker. A failed or paused CDC task does not mean the worker is unavailable; check task state below. UNKNOWN means worker state could not be collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(kafka_connect_connector_status{job=\"connect\"}) > bool 0 and on() (min(up{job=\"connect\"}) == 1) and on() (min(jmx_scrape_error{job=\"connect\"}) == 0)) or (min(up{job=\"connect\"}) == 0) or vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "UNKNOWN",
                  "color": "orange"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "text": {
          "valueSize": 32,
          "titleSize": 14
        },
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kafka",
      "description": "A Kafka metadata request finds at least one broker. If metadata is unavailable and the broker process endpoint is down, the service is DOWN. UNKNOWN means broker availability cannot be determined.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min((kafka_brokers{job=\"kafka-consumers\"} > bool 0) and on(job, instance) (up{job=\"kafka-consumers\"} == 1)) or (min(up{job=\"kafka\"}) == 0) or vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
