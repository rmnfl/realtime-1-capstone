    {
      "id": 8,
      "type": "row",
      "title": "PostgreSQL",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PostgreSQL connection and slot activity",
      "description": "Database connected: postgres-exporter can connect to PostgreSQL. Replication slot active: a replication client is attached. Both use 1 = yes, 0 = no; neither confirms that the client is making progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "Database connected",
          "range": true
        },
        {
          "refId": "B",
          "expr": "pg_replication_slot_slot_is_active{slot_name=\"capstone_slot\"}",
          "legendFormat": "Replication slot active",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WAL retained and awaiting confirmation",
      "description": "Retained WAL is measured from restart_lsn and may remain nonzero after delivery catches up. Unconfirmed WAL is measured from confirmed_flush_lsn. Both values are bytes, not seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_replication_slots_pg_wal_lsn_diff{slot_name=\"capstone_slot\"}",
          "legendFormat": "Retained WAL",
          "range": true
        },
        {
          "refId": "B",
          "expr": "clamp_min(pg_replication_slot_slot_current_wal_lsn{slot_name=\"capstone_slot\"} - pg_replication_slot_slot_confirmed_flush_lsn{slot_name=\"capstone_slot\"}, 0)",
          "legendFormat": "Unconfirmed WAL",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "description": "Current connections to the capstone database, including application, replication and monitoring connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=\"capstone\"}",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PostgreSQL transactions / sec",
      "description": "Committed and rolled-back transactions in capstone, including monitoring queries. These are rates, not total transaction counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "capstone-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname=\"capstone\"}[1m])",
          "legendFormat": "Commits",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"capstone\"}[1m])",
          "legendFormat": "Rollbacks",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Debezium / Kafka Connect",
      "collapsed": false,
